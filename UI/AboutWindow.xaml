<Window x:Class="DCF.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About DCF"
        Height="300"
        Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="15">
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Stretch">

            <!-- Назва плагіна -->
            <TextBlock Text="Direct Connection Finder (DCF)"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,15"
                       TextWrapping="Wrap"/>

            <!-- Версія -->
            <TextBlock x:Name="VersionText"
                       Margin="0,0,0,10"
                       TextWrapping="Wrap"/>

            <!-- Ліцензія -->
            <TextBlock x:Name="LicenseInfo"
                       Margin="0,0,0,10"
                       TextWrapping="Wrap"/>

            <!-- Компанія -->
            <TextBlock Text="VoltikPRO"
                       Margin="0,0,0,10"
                       TextWrapping="Wrap"/>

            <!-- Email підтримки -->
            <TextBlock Text="volodymyrdavydovychwork+VP@gmail.com"
                       Margin="0,0,0,10"
                       TextWrapping="Wrap"/>

            <!-- GitHub Pages -->
            <TextBlock Text="https://voltikpro.github.io/VP-Hub/"
                       Foreground="Blue"
                       TextDecorations="Underline"
                       Cursor="Hand"
                       MouseDown="GitHub_Click"
                       Margin="0,0,0,15"
                       TextWrapping="Wrap"/>

            <!-- Кнопка OK -->
            <Button Content="OK"
                    Width="100"
                    Height="30"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Click="OK_Click"/>

        </StackPanel>
    </Grid>
</Window>
